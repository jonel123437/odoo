<odoo>
    <data>
        <record id="view_hr_employee_document_list" model="ir.ui.view">
            <field name="name">hr.employee.document.list</field>
            <field name="model">hr.employee.document</field>
            <field name="arch" type="xml">
                <list string="Documents">
                    <field name="name"/>
                    <field name="document_type"/>
                    <field name="issue_date"/>
                    <field name="expiry_date"/>
                    <field name="state"/>
                    <field name="source"/>
                </list>
            </field>
        </record>

        <record id="view_hr_employee_document_form" model="ir.ui.view">
            <field name="name">hr.employee.document.form</field>
            <field name="model">hr.employee.document</field>
            <field name="arch" type="xml">
                <form string="Employee Document">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" readonly="source == 'builtin'"/>
                                <field name="document_type" readonly="source == 'builtin'"/>
                                <field name="employee_id" readonly="source == 'builtin'"/>
                                <field name="state" readonly="source == 'builtin'"/>
                                <field name="source" readonly="1"/>
                            </group>
                            <group>
                                <field name="issue_date" readonly="source == 'builtin'"/>
                                <field name="expiry_date" readonly="source == 'builtin'"/>
                                <field name="attachment" filename="attachment_filename"
                                       readonly="source == 'builtin'"/>
                                <field name="attachment_filename" invisible="1"/>
                            </group>
                        </group>
                        <group string="Notes" invisible="source == 'builtin'">
                            <field name="notes" nolabel="1"/>
                        </group>
                        <div invisible="source != 'builtin'"
                             class="alert alert-warning">
                            This document is managed from the Employee Profile. 
                            To edit or delete it, go to the employee's profile page.
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_employee_document" model="ir.actions.act_window">
            <field name="name">Employee Documents</field>
            <field name="res_model">hr.employee.document</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'employee_id'}</field>
        </record>

        <menuitem id="menu_hr_employee_document"
                  name="Documents"
                  parent="hr.menu_hr_root"
                  action="action_hr_employee_document"
                  sequence="50"/>
    </data>
</odoo>